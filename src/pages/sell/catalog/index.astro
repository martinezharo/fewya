---
import SellerLayout from '../../../layouts/SellerLayout.astro';
import Icon from '../../../components/icons/Icon.astro';
import CatalogProductCard from '../../../components/seller/CatalogProductCard.astro';
import { createSupabaseAuthClient } from '../../../lib/core/auth';
import { validateProductCompleteness } from '../../../lib/products/productValidation';
import { getTotalStock } from '../../../lib/products/variants';
import type { Product, ProductVariant } from '../../../lib/core/types';
const { t } = Astro.locals;

const supabase = createSupabaseAuthClient(Astro.cookies, Astro.request);
const { data: sessionData } = await supabase.auth.getSession();
const user = sessionData?.session?.user;

if (!user) return Astro.redirect('/sell');

const { data: profile } = await supabase
    .from('profiles')
    .select('is_seller')
    .eq('id', user.id)
    .single();

if (!profile?.is_seller) return Astro.redirect('/sell');

const { data: shop } = await supabase
    .from('shops')
    .select('id, name, slug')
    .eq('owner_id', user.id)
    .maybeSingle();

if (!shop) return Astro.redirect('/sell/onboarding');

const { data: products } = await supabase
    .from('products')
    .select('*, variants:product_variants(*)')
    .eq('shop_id', shop.id)
    .order('created_at', { ascending: false });

const allProducts: (Product & { variants?: ProductVariant[] })[] = (products ?? []) as any;

const productsWithCompleteness = allProducts.map(p => {
    const complete = validateProductCompleteness(p, p.variants ?? []);
    return { ...p, isComplete: complete.complete };
});

const activeCount = productsWithCompleteness.filter(p => p.is_active).length;
const totalStock = productsWithCompleteness.reduce((sum, p) => sum + getTotalStock(p.variants), 0);

const stats = [
    { label: t.sellerCatalogTotalProducts, value: allProducts.length },
    { label: t.sellerCatalogActiveProducts, value: activeCount },
    { label: t.sellerCatalogStock, value: totalStock },
];
---

<SellerLayout title={t.sellerCatalogPageTitle} shopSlug={shop.slug} shopId={shop.id}>
    <div class="p-4 sm:p-6 lg:p-10">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
            <div>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-text-tertiary">{shop.name}</p>
                <h1 class="mt-2 text-2xl font-semibold tracking-tight text-text-primary">{t.sellerCatalogTitle}</h1>
            </div>
            <a
                href="/sell/catalog/new"
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-accent text-bg text-sm font-medium no-underline hover:scale-[1.02] transition-transform shrink-0"
            >
                <Icon name="plus" size={18} />
                {t.sellerCatalogNewProduct}
            </a>
        </div>

        <div class="grid grid-cols-3 gap-2 sm:gap-3 mb-6 sm:mb-8">
            {stats.map((stat) => (
                <section class="flex h-full flex-col rounded-2xl border border-border bg-surface p-3 shadow-sm sm:rounded-[28px] sm:p-5">
                    <p class="text-[10px] font-semibold uppercase tracking-[0.12em] text-text-tertiary sm:text-[11px] sm:tracking-[0.16em]">
                        {stat.label}
                    </p>
                    <p class="mt-auto pt-1.5 text-xl font-semibold tracking-tight text-text-primary tabular-nums sm:pt-3 sm:text-2xl">{stat.value}</p>
                </section>
            ))}
        </div>

        {productsWithCompleteness.length > 0 ? (
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-1" id="product-list">
                {productsWithCompleteness.map((product) => (
                    <CatalogProductCard product={product} shopSlug={shop.slug} />
                ))}
            </div>
        ) : (
            <section class="flex min-h-[360px] flex-col items-center justify-center rounded-[32px] border border-dashed border-border bg-surface px-6 py-12 text-center">
                <div class="flex h-16 w-16 items-center justify-center rounded-full border border-border text-text-tertiary">
                    <Icon name="grid" size={26} />
                </div>
                <h2 class="mt-5 text-xl font-semibold tracking-tight text-text-primary">{t.sellerCatalogEmptyTitle}</h2>
                <p class="mt-2 max-w-md text-sm text-text-secondary">{t.sellerCatalogEmptySubtitle}</p>
                <a
                    href="/sell/catalog/new"
                        class="mt-6 inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-accent text-bg text-sm font-medium no-underline hover:scale-[1.02] transition-transform"
                >
                    <Icon name="plus" size={18} />
                    {t.sellerCatalogNewProduct}
                </a>
            </section>
        )}
    </div>
</SellerLayout>

<div id="delete-dialog" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/50">
    <div class="bg-surface rounded-2xl border border-border p-6 mx-4 max-w-sm w-full shadow-xl">
        <p class="text-sm text-text-primary font-medium" id="delete-dialog-text"></p>
        <div class="mt-5 flex justify-end gap-3">
            <button type="button" id="delete-cancel-btn"                     class="px-4 py-2 rounded-xl text-sm font-medium text-text-secondary hover:text-text-primary hover:bg-border-light transition-colors">{t.sellerOnboardingPrev}</button>
            <button type="button" id="delete-confirm-btn" class="px-4 py-2 rounded-xl text-sm font-medium bg-red-500 text-white hover:bg-red-600 transition-colors">{t.sellerCatalogDelete}</button>
        </div>
    </div>
</div>

<script>
    import { getClientT } from '../../../lib/core/i18n';
    import { setBusy } from '../../../lib/ui/busy';
    import { toast } from '../../../lib/ui/toast';
    import { runSubmit } from '../../../lib/ui/submit';
    import { initMenus, closeAllMenus } from '../../../lib/ui/menu';

    const t = getClientT();

    function paintActiveState(btn: HTMLButtonElement, isActive: boolean) {
        btn.dataset.active = String(isActive);
        const dot = btn.querySelector<HTMLElement>('[data-status-dot]');
        const label = btn.querySelector<HTMLElement>('[data-status-label]');
        if (dot) {
            dot.className = `inline-block w-1.5 h-1.5 rounded-full shrink-0 ${isActive ? 'bg-green-500' : 'bg-text-tertiary'}`;
        }
        if (label) label.textContent = isActive ? t.sellerCatalogActive : t.sellerCatalogInactive;

        const card = btn.closest('article');
        // Incomplete products stay dimmed regardless of their active flag.
        if (card && card.dataset.isComplete !== 'false') card.classList.toggle('opacity-60', !isActive);
        if (card) card.dataset.isActive = String(isActive);
    }

    function initCatalogPage() {
        const list = document.getElementById('product-list');
        if (!list) return;

        initMenus();

        const dialog = document.getElementById('delete-dialog') as HTMLDivElement;
        const dialogText = document.getElementById('delete-dialog-text') as HTMLParagraphElement;
        const cancelBtn = document.getElementById('delete-cancel-btn') as HTMLButtonElement;
        const confirmBtn = document.getElementById('delete-confirm-btn') as HTMLButtonElement;
        let pendingDeleteId: string | null = null;

        function closeDialog() {
            pendingDeleteId = null;
            dialog.classList.add('hidden');
            dialog.classList.remove('flex');
        }

        list.querySelectorAll<HTMLButtonElement>('.toggle-active-btn').forEach(btn => {
            btn.addEventListener('click', async () => {
                const productId = btn.dataset.productId!;
                const wasActive = btn.dataset.active === 'true';
                const newActive = !wasActive;

                // Optimistic UI update
                paintActiveState(btn, newActive);
                setBusy(btn, true);

                try {
                    const res = await fetch(`/api/sell/catalog/toggle?id=${productId}`, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ is_active: newActive }),
                    });

                    if (!res.ok) {
                        paintActiveState(btn, wasActive);
                        toast.error(t.toastErrorGeneric);
                    }
                } catch {
                    paintActiveState(btn, wasActive);
                    toast.error(t.toastErrorNetwork);
                } finally {
                    setBusy(btn, false);
                }
            });
        });

        list.querySelectorAll<HTMLButtonElement>('.delete-product-btn').forEach(btn => {
            btn.addEventListener('click', () => {
                pendingDeleteId = btn.dataset.productId!;
                dialogText.textContent = t.sellerCatalogConfirmDelete;
                dialog.classList.remove('hidden');
                dialog.classList.add('flex');
            });
        });

        cancelBtn.addEventListener('click', closeDialog);

        dialog.addEventListener('click', (e) => {
            if (e.target === dialog) closeDialog();
        });

        confirmBtn.addEventListener('click', async () => {
            if (!pendingDeleteId) return;
            const deleteId = pendingDeleteId;

            const result = await runSubmit({
                button: confirmBtn,
                action: () => fetch(`/api/sell/catalog/product?id=${deleteId}`, { method: 'DELETE' }),
                successMsg: t.sellerProductDeleteSuccess,
                errorFallback: t.sellerProductDeleteError,
            });

            if (result.ok) {
                closeAllMenus();
                list.querySelector(`article[data-product-id="${deleteId}"]`)?.remove();
                closeDialog();
                if (list.children.length === 0) window.location.reload();
            }
        });
    }

    document.addEventListener('astro:page-load', initCatalogPage);
</script>