---
import { getRequestUser } from '../lib/core/auth';
import BuyerAppLayout from "../layouts/BuyerAppLayout.astro";
import { SignOutButton } from '@clerk/astro/components';
const { t } = Astro.locals;

const user = getRequestUser(Astro.request);

if (!user) {
    return Astro.redirect('/login?redirect_to=/profile');
}

const displayName = user.fullName
    ?? [user.firstName, user.lastName].filter(Boolean).join(' ').trim()
    ?? user.email
    ?? t.profileAnonymous;
const avatarUrl = user.avatarUrl;
---

<BuyerAppLayout title={t.profilePageTitle}>
    <main class="max-w-[480px] mx-auto px-4 pt-10 pb-24 md:pb-10">
        <div class="flex flex-col items-center gap-5 py-10">
            {avatarUrl ? (
                <img
                    src={avatarUrl}
                    alt={displayName}
                    class="w-20 h-20 rounded-full object-cover border border-border-light"
                    referrerpolicy="no-referrer"
                />
            ) : (
                <div class="w-20 h-20 rounded-full bg-surface border border-border-light flex items-center justify-center text-[32px] font-semibold text-text-secondary">
                    {displayName.charAt(0).toUpperCase()}
                </div>
            )}

            <div class="text-center">
                <h1 class="text-2xl font-bold text-text-primary tracking-[-0.5px]">{displayName}</h1>
                {user.email && <p class="text-[15px] text-text-secondary mt-1">{user.email}</p>}
            </div>

            <SignOutButton redirectUrl="/">
                <button
                    type="button"
                    class="mt-4 px-5 py-2.5 text-[14px] font-semibold rounded-full border border-border-light text-text-secondary transition-colors duration-150 hover:bg-border-light hover:text-text-primary"
                >
                    {t.profileSignOut}
                </button>
            </SignOutButton>
        </div>
    </main>
</BuyerAppLayout>
