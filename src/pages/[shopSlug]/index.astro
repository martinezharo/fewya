---
import BuyerDetailLayout from '../../layouts/BuyerDetailLayout.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import ShopContact from '../../components/product/ShopContact.astro';
import Icon from '../../components/icons/Icon.astro';
import { getMergedWishlistIds } from '../../lib/wishlist/wishlist';
import { getConvexShopCatalog } from '../../lib/products/convexCatalog';

import type { Shop, Product } from '../../lib/core/types';
const { t } = Astro.locals;

const { shopSlug } = Astro.params;

const convexCatalog = await getConvexShopCatalog(shopSlug!);
if (!convexCatalog) return Astro.redirect('/');

const shop: Shop = convexCatalog.shop;
const products: Product[] = convexCatalog.products;
const avgRating = convexCatalog.averageRating;
const totalReviews = convexCatalog.totalReviews;

const profileImg = shop.profile_img || '/placeholder.svg';

const wishedProductIds = await getMergedWishlistIds(Astro.cookies, Astro.request);

const siteOrigin = (Astro.site ?? new URL(`${Astro.url.protocol}//${Astro.url.host}`)).origin;
const shopUrl = `${siteOrigin}/${shop.slug}`;
const shopDescription = (shop.description || t.siteDescription).slice(0, 160);
const shopImage = shop.profile_img || shop.banner_img || undefined;
const shopOgImage = shopImage && !shopImage.startsWith('/') ? shopImage : undefined;

const shopJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'OnlineStore',
  name: shop.name,
  description: shop.description ?? undefined,
  url: shopUrl,
  image: shopOgImage,
  address: shop.location ? { '@type': 'PostalAddress', addressLocality: shop.location } : undefined,
  aggregateRating: totalReviews > 0 ? {
    '@type': 'AggregateRating',
    ratingValue: +avgRating.toFixed(2),
    reviewCount: totalReviews,
  } : undefined,
};
---

<BuyerDetailLayout title={`${shop.name} — ${t.siteTitle}`} description={shopDescription} image={shopOgImage}>
  <script
    is:inline
    slot="structured-data"
    type="application/ld+json"
    set:html={JSON.stringify(shopJsonLd)}
  />
  <main class="pb-[120px] md:pb-[60px]" data-gallery>
    <!-- Desktop Layout Wrapper -->
    <div class="md:max-w-[1200px] md:mx-auto md:px-10 md:py-8">
      
      <!-- Shop Header Section -->
      <div class="bg-bg md:rounded-2xl md:overflow-hidden md:border md:border-border-light md:mb-12">
        
        <!-- Banner -->
        <div class="relative w-full h-32 md:h-64 bg-border-light">
          {shop.banner_img ? (
            <img 
              src={shop.banner_img} 
              alt={shop.name} 
              class="w-full h-full object-cover"
            />
          ) : (
            <div class="w-full h-full bg-gradient-to-r from-accent/20 to-accent/40"></div>
          )}
        </div>

        <!-- Shop Info -->
        <div class="px-4 pb-6 md:px-8 md:pb-8 relative">
          <!-- Profile Image & Name (Mobile: Right integrated, Name Left) -->
          <div class="flex justify-between items-end -mt-10 md:-mt-16 mb-4">
            <div class="pt-12 md:pt-20 flex-1">
              <h1 class="text-2xl md:text-4xl font-bold text-text-primary leading-tight">
                {shop.name}
              </h1>
            </div>
            
            <div class="relative w-24 h-24 md:w-32 md:h-32 rounded-full border-4 border-bg overflow-hidden bg-bg shadow-sm shrink-0 ml-4">
              <img 
                src={profileImg} 
                alt={shop.name}
                class="w-full h-full object-cover"
              />
            </div>
          </div>

          <!-- Ratings & Stats -->
          <div class="flex items-center gap-4 mb-6">
            <div class="flex items-center gap-1.5">
              <Icon name="star" size={18} class="text-yellow-400 fill-current" />
              <span class="text-sm font-semibold text-text-primary">{avgRating.toFixed(1)}</span>
              <span class="text-sm text-text-tertiary">({totalReviews})</span>
            </div>
            <!-- More stats if available -->
            <div class="text-sm text-text-secondary">
              {products.length} {t.shopProductsCount}
            </div>
          </div>

          <!-- About & Location -->
          <div class="flex flex-col gap-6">
            <div>
              <h2 class="text-lg font-semibold text-text-primary mb-2">{t.shopAbout}</h2>
              <p class="text-sm text-text-secondary leading-relaxed whitespace-pre-line">
                {shop.description || t.shopNoDescription}
              </p>
            </div>
            {shop.location && (
              <div class="flex flex-col gap-2">
                <div class="flex items-center gap-2 text-sm text-text-secondary">
                  <Icon name="map-pin" size={18} />
                  <span>{shop.location}</span>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>

      <!-- Products Grid -->
      <div class="mt-8 md:mt-0">
        <div class="px-4 md:px-0 mb-6 flex items-center justify-between">
          <h2 class="text-xl md:text-2xl font-bold text-text-primary">
            {t.shopProducts}
          </h2>
        </div>
        
        <ProductGrid products={products} wishedProductIds={wishedProductIds} />
      </div>
    </div>
  </main>

  <ShopContact slot="floating" email={shop.contact_email} whatsapp={shop.whatsapp} />
</BuyerDetailLayout>
