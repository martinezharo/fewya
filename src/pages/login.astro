---
import Layout from '../layouts/Layout.astro';
import { SignIn } from '@clerk/astro/components';
import { getAuthRedirectPath } from '../lib/core/auth';
const { t } = Astro.locals;

const redirectTo = getAuthRedirectPath(Astro.url);
const signUpUrl = `/sign-up?redirect_to=${encodeURIComponent(redirectTo)}`;
---

<Layout title={t.loginPageTitle} description={t.loginPageDescription}>
  <main class="min-h-dvh flex flex-col items-center justify-center px-6">
    <div class="w-full max-w-sm flex flex-col items-center gap-8">
      {/* Logo */}
      <div class="flex flex-col items-center gap-3">
        <img src="/favicon.svg" alt="Fewya" class="w-16 h-16" draggable="false" />
        <span class="text-3xl font-bold tracking-tight text-text-primary font-[Jost]">
          {t.logoText}
        </span>
        <p class="text-sm text-text-secondary text-center">
          {t.loginSubtitle}
        </p>
      </div>

      {/* Login card */}
      <div class="w-full flex justify-center">
        <SignIn
          routing="hash"
          forceRedirectUrl={redirectTo}
          signUpForceRedirectUrl={redirectTo}
          signUpUrl={signUpUrl}
        />
      </div>

      {/* Back link */}
      <a href="/" class="text-sm text-text-secondary hover:text-text-primary transition-colors">
        {t.loginBackToHome}
      </a>
    </div>
  </main>
</Layout>
