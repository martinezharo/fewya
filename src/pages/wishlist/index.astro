---
import BuyerAppLayout from "../../layouts/BuyerAppLayout.astro";
import ProductGrid from "../../components/ProductGrid.astro";
import Icon from "../../components/icons/Icon.astro";
import { api } from '../../../convex/_generated/api';
import { createRequestConvexClient } from '../../lib/core/auth';
import { getWishlistIdsFromCookie } from "../../lib/wishlist/wishlist";
import { getConvexProductsByIds } from "../../lib/products/convexCatalog";

import type { Product } from "../../lib/core/types";
const { t } = Astro.locals;

const localIds = [...getWishlistIdsFromCookie(Astro.cookies)].reverse(); // newest first

let dbIds: string[] = [];
const convex = createRequestConvexClient(Astro.request);
if (convex) {
    try {
        dbIds = await convex.query(api.wishlist.mine, {});
    } catch (error) {
        console.error('Convex wishlist unavailable:', error);
    }
}

// Build ordered unique list: stored first (newest), then locals not already stored
const dbSet = new Set(dbIds);
const orderedIds = [...dbIds, ...localIds.filter(id => !dbSet.has(id))];
const wishedProductIds = new Set(orderedIds);

const products: Product[] = orderedIds.length > 0 ? await getConvexProductsByIds(orderedIds) : [];
---

<BuyerAppLayout title={t.wishlistPageTitle}>

    <main class="min-h-[50vh]">
        <div class="px-4 md:px-10 md:max-w-[1400px] md:mx-auto pt-6 pb-4">
            <h1 class="text-xl md:text-2xl font-bold text-text-primary">{t.navWishlist}</h1>
        </div>

        {products.length > 0 ? (
            <ProductGrid products={products} wishedProductIds={wishedProductIds} />
        ) : (
            <div class="flex flex-col items-center justify-center text-center px-6 py-20">
                <div class="w-16 h-16 mb-4 text-text-tertiary bg-border-light rounded-full flex items-center justify-center">
                    <Icon name="heart" size={24} />
                </div>
                <h2 class="text-[18px] font-semibold text-text-primary mb-2">
                    {t.wishlistEmpty}
                </h2>
                <p class="text-[14px] text-text-secondary mb-6">{t.wishlistEmptySub}</p>
                <a
                    href="/"
                    class="inline-flex items-center px-6 py-2.5 bg-accent text-bg text-sm font-semibold rounded-lg transition-colors hover:bg-accent-hover"
                >
                    {t.wishlistExploreCta}
                </a>
            </div>
        )}
    </main>
</BuyerAppLayout>
