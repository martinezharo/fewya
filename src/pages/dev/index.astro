---
import Layout from '../../layouts/Layout.astro';
import { isDevelopment } from '../../lib/core/env';

// Design playground: never reachable from a production deployment.
if (!isDevelopment) return new Response(null, { status: 404 });

const playgrounds = [
    {
        href: '/dev/catalog-cards',
        title: 'Tarjeta de catálogo (móvil)',
        description: 'Comparativa de la tarjeta actual con tres propuestas de diseño.',
    },
];
---

<Layout title="Dev · Playground" noindex>
    <main class="mx-auto min-h-dvh max-w-2xl px-6 py-12">
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-text-tertiary">Solo desarrollo</p>
        <h1 class="mt-1 text-2xl font-semibold tracking-tight text-text-primary">Playground</h1>
        <p class="mt-2 text-sm text-text-secondary">
            Maquetas para comparar diseños sin tocar las páginas reales. Esta ruta devuelve 404 en producción.
        </p>

        <ul class="mt-8 flex list-none flex-col gap-3 p-0">
            {playgrounds.map((item) => (
                <li>
                    <a
                        href={item.href}
                        class="block rounded-2xl border border-border bg-surface p-4 no-underline transition-colors hover:border-border-light"
                    >
                        <p class="text-sm font-semibold text-text-primary">{item.title}</p>
                        <p class="mt-1 text-xs text-text-secondary">{item.description}</p>
                    </a>
                </li>
            ))}
        </ul>
    </main>
</Layout>
