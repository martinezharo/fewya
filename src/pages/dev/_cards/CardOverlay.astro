---
import Icon from '../../../components/icons/Icon.astro';
import MockMenu from './MockMenu.astro';
import { price, type MockProduct } from './mock';

/**
 * Design C — "Overlay".
 *
 * The tile *is* the photo: name and price sit on a gradient over the bottom of
 * the image, so every card is exactly square and the grid stays perfectly
 * even no matter how long a title is. Densest of the three, but it puts text
 * over photography, which needs the scrim to stay legible.
 */
interface Props { product: MockProduct }
const { product } = Astro.props;

const problem = !product.isComplete
    ? { label: 'Incompleto', class: 'bg-amber-400 text-amber-950' }
    : product.stock === 0
      ? { label: 'Sin stock', class: 'bg-red-500 text-white' }
      : !product.isActive
        ? { label: 'Pausado', class: 'bg-black/60 text-white backdrop-blur-sm' }
        : null;
---

<article class="relative aspect-square overflow-hidden rounded-2xl bg-surface">
    {product.image ? (
        <img
            src={product.image}
            alt={product.title}
            class:list={['absolute inset-0 h-full w-full object-cover', !product.isActive && 'opacity-45 grayscale']}
        />
    ) : (
        <div class="absolute inset-0 flex items-center justify-center text-text-tertiary">
            <Icon name="image" size={28} />
        </div>
    )}

    {problem && (
        <span class={`absolute left-2 top-2 rounded-full px-2 py-0.5 text-[10px] font-semibold ${problem.class}`}>
            {problem.label}
        </span>
    )}

    <div class="absolute right-1.5 top-1.5">
        <MockMenu id={`c-${product.id}`} overlay active={product.isActive} />
    </div>

    <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 via-black/55 to-transparent px-2.5 pb-2.5 pt-10">
        <p class="truncate text-[13px] font-semibold leading-tight text-white">{product.title}</p>
        <div class="mt-0.5 flex items-baseline justify-between gap-2">
            <span class="text-[13px] font-semibold tabular-nums text-white">{price(product)}</span>
            <span class:list={[
                'text-[11px] tabular-nums',
                product.stock === 0 ? 'font-medium text-red-300' : 'text-white/70',
            ]}>{product.stock} uds</span>
        </div>
    </div>
</article>
