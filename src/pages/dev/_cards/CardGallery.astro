---
import Icon from '../../../components/icons/Icon.astro';
import MockMenu from './MockMenu.astro';
import { price, type MockProduct } from './mock';

/**
 * Design A — "Galería".
 *
 * No card chrome at all: the photos are the interface. Text is reduced to the
 * two things you cannot recognise from a thumbnail (name and price), and state
 * is expressed on the photo itself — a paused product is dimmed, and a chip
 * only appears when something is wrong. Reads as a catalog, not as a table.
 */
interface Props { product: MockProduct }
const { product } = Astro.props;

const problem = !product.isComplete
    ? { label: 'Incompleto', class: 'bg-amber-400 text-amber-950' }
    : product.stock === 0
      ? { label: 'Sin stock', class: 'bg-red-500 text-white' }
      : !product.isActive
        ? { label: 'Pausado', class: 'bg-black/60 text-white backdrop-blur-sm' }
        : null;
---

<article class="group relative flex flex-col gap-2">
    <div class="relative aspect-square overflow-hidden rounded-2xl bg-surface">
        {product.image ? (
            <img
                src={product.image}
                alt={product.title}
                class:list={['h-full w-full object-cover transition', !product.isActive && 'opacity-40 grayscale']}
            />
        ) : (
            <div class="flex h-full w-full items-center justify-center text-text-tertiary">
                <Icon name="image" size={28} />
            </div>
        )}

        {problem && (
            <span class={`absolute left-2 top-2 rounded-full px-2 py-0.5 text-[10px] font-semibold ${problem.class}`}>
                {problem.label}
            </span>
        )}

        <div class="absolute right-1.5 top-1.5">
            <MockMenu id={`a-${product.id}`} overlay active={product.isActive} />
        </div>
    </div>

    <div class="px-0.5">
        <p class="truncate text-[13px] font-medium leading-tight text-text-primary">{product.title}</p>
        <p class="mt-1 flex items-baseline gap-1.5">
            <span class="text-[13px] font-semibold tabular-nums text-text-primary">{price(product)}</span>
            <span class:list={[
                'text-[11px] tabular-nums',
                product.stock === 0 ? 'font-medium text-red-500 dark:text-red-400' : 'text-text-tertiary',
            ]}>{product.stock} uds</span>
        </p>
    </div>
</article>
