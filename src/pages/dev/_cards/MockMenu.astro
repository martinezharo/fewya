---
import Icon from '../../../components/icons/Icon.astro';

interface Props {
    id: string;
    /** Sits on top of the photo (glassy dark button) instead of on the card surface. */
    overlay?: boolean;
    active?: boolean;
}

const { id, overlay = false, active = true } = Astro.props;
const item = 'flex w-full items-center gap-2 rounded-lg px-3 py-2 text-xs font-medium text-text-secondary no-underline transition-colors hover:bg-border-light hover:text-text-primary';
---

<div class="relative" data-menu>
    <button
        type="button"
        data-menu-button
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls={id}
        aria-label="Más acciones"
        class:list={[
            'inline-flex items-center justify-center rounded-full transition-colors',
            overlay
                ? 'h-8 w-8 bg-black/45 text-white backdrop-blur-sm hover:bg-black/65'
                : 'h-8 w-8 text-text-secondary hover:bg-border-light hover:text-text-primary',
        ]}
    >
        <Icon name="more-vertical" size={18} />
    </button>
    <div
        id={id}
        data-menu-panel
        class="hidden absolute right-0 top-full z-30 mt-1 w-44 rounded-xl border border-border bg-surface p-1 shadow-lg"
    >
        <a href="#" class={item}><Icon name="pencil" size={15} />Editar</a>
        <a href="#" class={item}><Icon name="external-link" size={15} />Ver en tienda</a>
        <button type="button" class={item}>
            <span class:list={['inline-block h-1.5 w-1.5 rounded-full', active ? 'bg-green-500' : 'bg-text-tertiary']}></span>
            {active ? 'Desactivar' : 'Activar'}
        </button>
        <button type="button" class={`${item} text-red-500 hover:bg-red-50 hover:text-red-500 dark:text-red-400 dark:hover:bg-red-900/20`}>
            <Icon name="trash-2" size={15} />Eliminar
        </button>
    </div>
</div>
