---
import Layout from '../../../layouts/Layout.astro';
import CatalogProductCard from '../../../components/seller/CatalogProductCard.astro';
import CardGallery from '../_cards/CardGallery.astro';
import CardSheet from '../_cards/CardSheet.astro';
import CardOverlay from '../_cards/CardOverlay.astro';
import { mockProducts } from '../_cards/mock';
import { CARD_VARIANTS } from '../_cards/variants';
import { isDevelopment } from '../../../lib/core/env';

// Design playground: never reachable from a production deployment.
if (!isDevelopment) return new Response(null, { status: 404 });

const { variant } = Astro.params;
if (!CARD_VARIANTS.some(v => v.key === variant)) return new Response(null, { status: 404 });

// The shipped component expects a real Product; the playground only needs the
// fields it reads, so adapt the fixtures instead of duplicating them.
const asProduct = mockProducts.map(p => ({
    id: p.id,
    shop_id: 'mock',
    title: p.title,
    description: '',
    category: 'tech',
    gallery_images: p.image ? [p.image] : [],
    is_active: p.isActive,
    created_at: '',
    brand: null,
    specifications: {},
    slug: `mock-${p.id}`,
    isComplete: p.isComplete,
    variants: Array.from({ length: p.variants }, (_, i) => ({
        id: `${p.id}-${i}`,
        product_id: p.id,
        variant_name: null,
        price: i === 0 ? p.price : p.price + 2,
        stock: i === 0 ? p.stock : 0,
        attributes: {},
        variant_image: null,
        created_at: '',
        is_default: i === 0,
        weight_kg: 1,
        length_cm: 1,
        width_cm: 1,
        height_cm: 1,
        shipping_cost: 0,
    })),
})) as any[];
---

<Layout title={`Dev · Tarjeta ${variant}`} noindex>
    <main class="min-h-dvh bg-bg p-4">
        {/* The shipped card switches to the desktop row at `sm`, so its grid
            has to match the real page instead of forcing two columns. */}
        <div class:list={['grid gap-3 grid-cols-2', variant === 'current' && 'sm:grid-cols-1']}>
            {variant === 'current' && asProduct.map((product) => (
                <CatalogProductCard product={product} shopSlug="octopus" />
            ))}
            {variant === 'a' && mockProducts.map((product) => <CardGallery product={product} />)}
            {variant === 'b' && mockProducts.map((product) => <CardSheet product={product} />)}
            {variant === 'c' && mockProducts.map((product) => <CardOverlay product={product} />)}
        </div>
    </main>
</Layout>

<script>
    import { initMenus } from '../../../lib/ui/menu';
    document.addEventListener('astro:page-load', initMenus);
    initMenus();
</script>
