---
import ProductGrid from "../ProductGrid.astro";
import type { SearchParams } from "../../lib/products/search";
import { getMergedWishlistIds } from "../../lib/wishlist/wishlist";
import { getConvexSearchProducts } from "../../lib/products/convexCatalog";

import type { Product } from "../../lib/core/types";
const { t } = Astro.locals;

interface Props {
    params: SearchParams;
}

// params come from the page as a prop: inside a server island Astro.request.url
// points at the island endpoint, so it does NOT carry the original ?q=... query.
const { params } = Astro.props;

// Relevance-ranked search, visibility and stock filtering run in Convex.
const [convexProducts, wishedProductIds] = await Promise.all([
    getConvexSearchProducts(params),
    getMergedWishlistIds(Astro.cookies, Astro.request),
]);

const products: Product[] = convexProducts ?? [];
---

{products.length > 0 ? (
    <div class="pt-4">
        <ProductGrid products={products} wishedProductIds={wishedProductIds} />
    </div>
) : (
    <div class="flex flex-col items-center justify-center text-center px-6 py-20">
        <div class="w-16 h-16 mb-4 text-text-tertiary bg-border-light rounded-full flex items-center justify-center">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="text-text-secondary"><circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.75"/><path d="m21 21-4.3-4.3" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
        </div>
        <h2 class="text-[18px] font-semibold text-text-primary mb-2">
            {t.searchNoResults} {params.q && `"${params.q}"`}
        </h2>
        <p class="text-[14px] text-text-secondary">{t.searchTryDifferentTerms}</p>
    </div>
)}
