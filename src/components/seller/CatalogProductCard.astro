---
import Icon from '../icons/Icon.astro';
import { formatCurrency } from '../../lib/core/formatCurrency';
import { getCategoryLabel } from '../../lib/core/i18n';
import { optimizeImageUrl } from '../../lib/ui/imageOptimize';
import { getDefaultVariant, getTotalStock } from '../../lib/products/variants';
import type { Product, ProductVariant } from '../../lib/core/types';

/**
 * A single catalog entry in the seller dashboard.
 *
 * One markup tree serves both breakpoints. From `sm` upwards it is the dense
 * scanning row desktop sellers already had, icon strip included. On phones it
 * becomes a tile in a two-up grid — square photo, then exactly two lines of
 * text (name, and one meta line with price and stock) — because five stacked
 * elements per tile is what made the previous grid feel cluttered. Everything
 * else moves onto the photo: a dot for live/paused, a chip when buyers cannot
 * see the product yet, and the actions menu.
 *
 * State is driven by `data-is-active` on the card rather than by classes the
 * toggle script rewrites, so the dot, the labels and the dimming can never
 * drift apart from each other.
 */
interface Props {
    product: Product & { variants?: ProductVariant[]; isComplete: boolean };
    shopSlug?: string;
}

const { t, locale } = Astro.locals;
const { product, shopSlug } = Astro.props;

const variants = product.variants ?? [];
const defaultVariant = getDefaultVariant(variants);
const prices = variants.length ? variants.map(v => v.price) : [defaultVariant?.price ?? 0];
const minPrice = Math.min(...prices);
const maxPrice = Math.max(...prices);
const priceLabel = minPrice === maxPrice
    ? formatCurrency(minPrice, locale)
    : `${t.sellerCatalogPriceFrom} ${formatCurrency(minPrice, locale)}`;

const stock = getTotalStock(variants);
const stockLabel = t.sellerProductVariantSummaryStock.replace('{count}', String(stock));

const rawImage = product.gallery_images?.[0] || defaultVariant?.variant_image || '';
const image = rawImage ? optimizeImageUrl(rawImage, 400) : '';
const categoryLabel = getCategoryLabel(t, product.category ?? '');

const editUrl = `/sell/catalog/${product.id}`;
const publicUrl = shopSlug && product.slug && product.isComplete ? `/${shopSlug}/${product.slug}` : null;
const menuId = `catalog-menu-${product.id}`;

/** Menu row on phones, icon button in the desktop strip. */
const ACTION_LAYOUT = 'flex items-center gap-2 rounded-lg px-3 py-2 text-xs font-medium text-text-secondary no-underline transition-colors sm:h-8 sm:w-8 sm:justify-center sm:gap-0 sm:px-0 sm:py-0';
const ACTION_CLASS = `${ACTION_LAYOUT} hover:bg-border-light hover:text-text-primary`;
const DELETE_CLASS = `${ACTION_LAYOUT} w-full hover:bg-red-50 hover:text-red-500 dark:hover:bg-red-900/20 dark:hover:text-red-400`;
---

<article
    class:list={[
        'group relative flex flex-col rounded-2xl border border-border bg-surface transition-colors',
        'hover:border-border-light focus-within:border-border-light',
        // Lift the card while its menu is open so the panel is never painted
        // under the cards that follow it in the grid.
        'data-[menu-open]:z-20',
        'sm:flex-row sm:items-center sm:gap-4 sm:p-4',
        // Desktop dims the whole row, as it always has. On phones only the
        // photo dims, so the name and price of a paused product stay readable.
        'sm:data-[is-active=false]:opacity-60 sm:data-[is-complete=false]:opacity-60',
    ]}
    data-menu
    data-product-id={product.id}
    data-is-active={String(product.is_active)}
    data-is-complete={String(product.isComplete)}
    data-stock={String(stock)}
>
    <div class="relative flex w-full aspect-square shrink-0 items-center justify-center overflow-hidden rounded-t-2xl bg-bg sm:h-20 sm:w-20 sm:rounded-xl">
        {image ? (
            <img
                src={image}
                alt={product.title}
                class="h-full w-full object-cover max-sm:group-data-[is-active=false]:opacity-45"
                width="400"
                height="400"
                loading="lazy"
                decoding="async"
            />
        ) : (
            <Icon name="image" size={28} class="text-text-tertiary" />
        )}

        {/* Phone-only state, carried by the photo. Desktop says both in words:
            the status pill and the badges next to the title. */}
        <span
            class="absolute left-2.5 top-2.5 h-2.5 w-2.5 rounded-full bg-slate-400 ring-2 ring-black/25 group-data-[is-active=true]:bg-green-500 sm:hidden"
            aria-hidden="true"
        ></span>

        {!product.isComplete && (
            <span
                class="absolute bottom-2 left-2 inline-flex items-center gap-1 rounded-full bg-amber-400 px-2 py-0.5 text-[10px] font-semibold text-amber-950 sm:hidden"
                title={t.sellerCatalogIncompleteTooltip}
            >
                <Icon name="alert-triangle" size={11} />
                {t.sellerCatalogIncompleteWarning}
            </span>
        )}

        <button
            type="button"
            data-menu-button
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls={menuId}
            aria-label={t.sellerCatalogMoreActions}
            class="absolute right-1.5 top-1.5 z-10 inline-flex h-8 w-8 items-center justify-center rounded-full bg-black/45 text-white backdrop-blur-sm transition-colors hover:bg-black/65 sm:hidden"
        >
            <Icon name="more-vertical" size={18} />
        </button>
    </div>

    {/* Phone: padded stack under the photo. Desktop: `contents` hands the three
        blocks below straight to the card's flex row. */}
    <div class="flex min-w-0 flex-1 flex-col p-2.5 sm:contents">
        <div class="min-w-0 flex-1">
            <a
                href={editUrl}
                class="block truncate text-[13px] font-semibold text-text-primary no-underline after:absolute after:inset-0 after:rounded-2xl sm:text-sm"
            >
                {product.title}
            </a>
            {/* Desktop has the width for the full status line; on phones the
                same information is on the photo or in the meta line. */}
            <div class="mt-1.5 hidden flex-wrap items-center gap-1.5 sm:flex">
                {!product.isComplete && (
                    <span
                        class="inline-flex items-center gap-1 rounded-full border border-amber-200 bg-amber-100 px-2 py-0.5 text-[10px] font-medium text-amber-800 dark:border-amber-800 dark:bg-amber-900/30 dark:text-amber-400"
                        title={t.sellerCatalogIncompleteTooltip}
                    >
                        <Icon name="alert-triangle" size={12} />
                        {t.sellerCatalogIncompleteWarning}
                    </span>
                )}
                {stock === 0 && (
                    <span class="inline-flex items-center gap-1 rounded-full border border-red-200 bg-red-100 px-2 py-0.5 text-[10px] font-medium text-red-700 dark:border-red-800 dark:bg-red-900/30 dark:text-red-400">
                        <Icon name="alert-triangle" size={12} />
                        {t.productOutOfStock}
                    </span>
                )}
                <span class="inline-flex items-center rounded-full border border-border bg-bg px-2 py-0.5 text-[11px] font-medium text-text-secondary">
                    {categoryLabel}
                </span>
                {variants.length > 1 && (
                    <span class="text-[11px] text-text-tertiary">
                        {variants.length} {t.sellerCatalogVariants}
                    </span>
                )}
            </div>
        </div>

        <p class="mt-1 shrink-0 text-[12px] text-text-tertiary sm:mt-0 sm:flex sm:flex-col sm:items-end sm:gap-0.5 sm:text-right">
            <span class="text-[13px] font-semibold tabular-nums text-text-primary sm:text-sm">{priceLabel}</span>
            <span class="px-1 sm:hidden" aria-hidden="true">·</span>
            <span class:list={[
                'tabular-nums sm:text-[11px]',
                stock === 0 && 'font-medium text-red-500 dark:text-red-400',
            ]}>{stockLabel}</span>
        </p>

        {/* `contents` on phones so the dropdown below positions against the
            card, not against this wrapper. */}
        <div class="contents sm:relative sm:z-10 sm:flex sm:shrink-0 sm:items-center sm:justify-end sm:gap-2">
            <button
                type="button"
                class="toggle-active-btn hidden items-center gap-1.5 rounded-lg px-3 py-1.5 text-xs font-medium text-text-secondary transition-colors hover:bg-border-light hover:text-text-primary sm:flex"
                data-product-id={product.id}
                data-active={String(product.is_active)}
                aria-label={t.sellerCatalogToggleActive}
            >
                <span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-text-tertiary group-data-[is-active=true]:bg-green-500"></span>
                <span class="group-data-[is-active=false]:hidden">{t.sellerCatalogActive}</span>
                <span class="group-data-[is-active=true]:hidden">{t.sellerCatalogInactive}</span>
            </button>

            {/* The same actions render as a dropdown on phones and as the
                desktop icon strip: absolute + panel chrome below `sm`, inline
                and label-less above it. */}
            <div
                id={menuId}
                data-menu-panel
                class="hidden absolute right-1.5 top-11 z-30 w-40 rounded-xl border border-border bg-surface p-1 shadow-lg
                       sm:static sm:flex sm:w-auto sm:items-center sm:gap-1 sm:rounded-none sm:border-0 sm:bg-transparent sm:p-0 sm:shadow-none"
            >
                <button
                    type="button"
                    class={`toggle-active-btn ${ACTION_CLASS} w-full sm:hidden`}
                    data-product-id={product.id}
                    data-active={String(product.is_active)}
                >
                    <span class="inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-text-tertiary group-data-[is-active=true]:bg-green-500"></span>
                    <span class="group-data-[is-active=false]:hidden">{t.sellerCatalogDeactivate}</span>
                    <span class="group-data-[is-active=true]:hidden">{t.sellerCatalogActivate}</span>
                </button>
                <a href={editUrl} aria-label={t.sellerCatalogEdit} class={ACTION_CLASS}>
                    <Icon name="pencil" size={16} />
                    <span class="sm:hidden">{t.sellerCatalogEdit}</span>
                </a>
                {publicUrl && (
                    <a
                        href={publicUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={t.sellerCatalogViewPublic}
                        class={ACTION_CLASS}
                    >
                        <Icon name="external-link" size={16} />
                        <span class="sm:hidden">{t.sellerCatalogViewPublic}</span>
                    </a>
                )}
                <button
                    type="button"
                    data-product-id={product.id}
                    aria-label={t.sellerCatalogDelete}
                    class={`delete-product-btn ${DELETE_CLASS}`}
                >
                    <Icon name="trash-2" size={16} />
                    <span class="sm:hidden">{t.sellerCatalogDelete}</span>
                </button>
            </div>
        </div>
    </div>
</article>
