---
import Icon from '../icons/Icon.astro';
import { formatCurrency } from '../../lib/core/formatCurrency';
import { getCategoryLabel } from '../../lib/core/i18n';
import { optimizeImageUrl } from '../../lib/ui/imageOptimize';
import { getDefaultVariant, getTotalStock } from '../../lib/products/variants';
import type { Product, ProductVariant } from '../../lib/core/types';

/**
 * A single catalog entry in the seller dashboard.
 *
 * One markup tree serves both breakpoints: on phones it renders as a square
 * tile (two per row, image kept at a 1:1 ratio so photos aren't cropped into
 * a letterbox), and from `sm` upwards the body collapses via `sm:contents`
 * into the dense scanning row that desktop sellers work with.
 *
 * The desktop icon strip is unchanged; on phones those same actions collapse
 * into a dropdown (see `src/lib/ui/menu.ts`), because a row of four buttons
 * does not fit in a half-width tile. The whole card is a link to the editor
 * via the stretched title link.
 */
interface Props {
    product: Product & { variants?: ProductVariant[]; isComplete: boolean };
    shopSlug?: string;
}

const { t, locale } = Astro.locals;
const { product, shopSlug } = Astro.props;

const variants = product.variants ?? [];
const defaultVariant = getDefaultVariant(variants);
const prices = variants.length ? variants.map(v => v.price) : [defaultVariant?.price ?? 0];
const minPrice = Math.min(...prices);
const maxPrice = Math.max(...prices);
const priceLabel = minPrice === maxPrice
    ? formatCurrency(minPrice, locale)
    : `${t.sellerCatalogPriceFrom} ${formatCurrency(minPrice, locale)}`;

const stock = getTotalStock(variants);
const stockLabel = t.sellerProductVariantSummaryStock.replace('{count}', String(stock));

const rawImage = product.gallery_images?.[0] || defaultVariant?.variant_image || '';
const image = rawImage ? optimizeImageUrl(rawImage, 400) : '';
const categoryLabel = getCategoryLabel(t, product.category ?? '');

const editUrl = `/sell/catalog/${product.id}`;
const publicUrl = shopSlug && product.slug && product.isComplete ? `/${shopSlug}/${product.slug}` : null;
const menuId = `catalog-menu-${product.id}`;

/** Menu row on phones, icon button in the desktop strip. */
const ACTION_LAYOUT = 'flex items-center gap-2 rounded-lg px-3 py-2 text-xs font-medium text-text-secondary no-underline transition-colors sm:h-8 sm:w-8 sm:justify-center sm:gap-0 sm:px-0 sm:py-0';
const ACTION_CLASS = `${ACTION_LAYOUT} hover:bg-border-light hover:text-text-primary`;
const DELETE_CLASS = `${ACTION_LAYOUT} w-full hover:bg-red-50 hover:text-red-500 dark:hover:bg-red-900/20 dark:hover:text-red-400`;
---

<article
    class:list={[
        'group relative flex flex-col rounded-2xl border border-border bg-surface transition-colors',
        'hover:border-border-light focus-within:border-border-light',
        // Lift the whole card while its menu is open so the panel is never
        // painted under the cards that follow it in the grid.
        'has-[[data-menu-open]]:z-20',
        'sm:flex-row sm:items-center sm:gap-4 sm:p-4',
        (!product.is_active || !product.isComplete) && 'opacity-60',
    ]}
    data-product-id={product.id}
    data-is-active={String(product.is_active)}
    data-is-complete={String(product.isComplete)}
>
    <div class="w-full aspect-square shrink-0 overflow-hidden rounded-t-2xl bg-bg flex items-center justify-center sm:w-20 sm:h-20 sm:rounded-xl">
        {image ? (
            <img src={image} alt={product.title} class="w-full h-full object-cover" width="400" height="400" loading="lazy" decoding="async" />
        ) : (
            <Icon name="image" size={28} class="text-text-tertiary" />
        )}
    </div>

    {/* Phone: padded stack under the image. Desktop: `contents` hands the three
        blocks below straight to the card's flex row. */}
    <div class="flex min-w-0 flex-1 flex-col gap-2 p-3 sm:contents">
        <div class="min-w-0 flex-1">
            <a
                href={editUrl}
                class="text-sm font-semibold text-text-primary no-underline line-clamp-2 sm:truncate sm:block after:absolute after:inset-0 after:rounded-2xl"
            >
                {product.title}
            </a>
            <div class="mt-1.5 flex flex-wrap items-center gap-1.5">
                {!product.isComplete && (
                    <span
                        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-400 border border-amber-200 dark:border-amber-800"
                        title={t.sellerCatalogIncompleteTooltip}
                    >
                        <Icon name="alert-triangle" size={12} />
                        {t.sellerCatalogIncompleteWarning}
                    </span>
                )}
                {stock === 0 && (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-medium bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400 border border-red-200 dark:border-red-800">
                        <Icon name="alert-triangle" size={12} />
                        {t.productOutOfStock}
                    </span>
                )}
                <span class="hidden sm:inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-bg text-text-secondary border border-border">
                    {categoryLabel}
                </span>
                {variants.length > 1 && (
                    <span class="hidden sm:inline text-[11px] text-text-tertiary">
                        {variants.length} {t.sellerCatalogVariants}
                    </span>
                )}
            </div>
        </div>

        <div class="flex items-baseline justify-between gap-2 shrink-0 sm:flex-col sm:items-end sm:gap-0.5 sm:text-right">
            <p class="text-sm font-semibold text-text-primary tabular-nums">{priceLabel}</p>
            <p class:list={[
                'text-[11px] tabular-nums',
                stock === 0 ? 'text-red-500 dark:text-red-400 font-medium' : 'text-text-tertiary',
            ]}>{stockLabel}</p>
        </div>

        <div class="relative z-10 flex items-center justify-between gap-1 shrink-0 sm:justify-end sm:gap-2">
            <button
                type="button"
                class="toggle-active-btn flex items-center gap-1.5 rounded-lg px-2 py-1.5 text-xs font-medium text-text-secondary transition-colors hover:bg-border-light hover:text-text-primary sm:px-3"
                data-product-id={product.id}
                data-active={String(product.is_active)}
                aria-label={t.sellerCatalogToggleActive}
            >
                <span
                    data-status-dot
                    class:list={[
                        'inline-block w-1.5 h-1.5 rounded-full shrink-0',
                        product.is_active ? 'bg-green-500' : 'bg-text-tertiary',
                    ]}
                ></span>
                <span data-status-label>{product.is_active ? t.sellerCatalogActive : t.sellerCatalogInactive}</span>
            </button>

            {/* The same three actions render as an icon strip on desktop (where
                there is room for it) and as a dropdown on phones, where a
                four-button row would not fit next to the status pill. */}
            <div class="relative" data-menu>
                <button
                    type="button"
                    class="inline-flex items-center justify-center w-8 h-8 rounded-lg text-text-secondary transition-colors hover:bg-border-light hover:text-text-primary sm:hidden"
                    data-menu-button
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-controls={menuId}
                    aria-label={t.sellerCatalogMoreActions}
                >
                    <Icon name="more-vertical" size={18} />
                </button>
                <div
                    id={menuId}
                    data-menu-panel
                    class="hidden absolute right-0 top-full z-30 mt-1 w-40 origin-top-right rounded-xl border border-border bg-surface p-1 shadow-lg
                           sm:static sm:mt-0 sm:flex sm:w-auto sm:items-center sm:gap-1 sm:rounded-none sm:border-0 sm:bg-transparent sm:p-0 sm:shadow-none"
                >
                    <a
                        href={editUrl}
                        aria-label={t.sellerCatalogEdit}
                        class={ACTION_CLASS}
                    >
                        <Icon name="pencil" size={16} />
                        <span class="sm:hidden">{t.sellerCatalogEdit}</span>
                    </a>
                    {publicUrl && (
                        <a
                            href={publicUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={t.sellerCatalogViewPublic}
                            class={ACTION_CLASS}
                        >
                            <Icon name="external-link" size={16} />
                            <span class="sm:hidden">{t.sellerCatalogViewPublic}</span>
                        </a>
                    )}
                    <button
                        type="button"
                        data-product-id={product.id}
                        aria-label={t.sellerCatalogDelete}
                        class={`delete-product-btn ${DELETE_CLASS}`}
                    >
                        <Icon name="trash-2" size={16} />
                        <span class="sm:hidden">{t.sellerCatalogDelete}</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</article>
