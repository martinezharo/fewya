---
import Icon from '../icons/Icon.astro';
import { getSellerNavItems, getSellerDetailsNavItem, getSellerFooterNavItem } from '../../lib/ui/seller-nav';
const { t } = Astro.locals;
const sellerNavItems = getSellerNavItems(t);
const sellerDetailsNavItem = getSellerDetailsNavItem(t);
const sellerFooterNavItem = getSellerFooterNavItem(t);

interface Props {
    currentPath: string;
    shopSlug?: string;
    stripeStatus?: 'not_connected' | 'pending' | 'ready';
    activeIncidents?: number;
    pendingOrdersCount?: number;
    deliveryFailedCount?: number;
    incompleteProductsCount?: number;
    sellerDetailsIncomplete?: boolean;
}

const { currentPath, shopSlug, stripeStatus = 'not_connected', activeIncidents = 0, pendingOrdersCount = 0, deliveryFailedCount = 0, incompleteProductsCount = 0, sellerDetailsIncomplete = false } = Astro.props;

function isActive(href: string) {
    if (href === '/sell') return currentPath === '/sell';
    return currentPath === href || currentPath.startsWith(href + '/');
}
---

<!-- Mobile backdrop -->
<div
    id="seller-sidebar-backdrop"
    class="fixed inset-0 z-40 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
    aria-hidden="true"
></div>

<aside
    id="seller-sidebar"
    aria-label={t.sellerSidebarLabel}
    class="
        fixed inset-y-0 left-0 z-50 flex flex-col shrink-0
        bg-surface border-r border-border
        -translate-x-full transition-transform duration-300 ease-in-out
        lg:sticky lg:top-0 lg:h-dvh lg:translate-x-0
    "
>
    <!-- Header -->
    <div class="sidebar-header flex items-center h-16 px-4 border-b border-border shrink-0 overflow-hidden">
        <a
            href="/sell"
            class="sidebar-brand flex-1 min-w-0 font-semibold text-sm text-text-primary tracking-tight truncate"
        >
            {t.sellerBrandName}
        </a>

        <!-- Desktop: collapse/expand toggle -->
        <button
            id="seller-sidebar-collapse-btn"
            class="hidden lg:flex shrink-0 items-center justify-center w-8 h-8 rounded-lg text-text-tertiary hover:text-text-primary hover:bg-border-light transition-colors"
            aria-label={t.sellerSidebarCollapseLabel}
        >
            <Icon name="panel-left" size={16} />
        </button>

        <!-- Mobile: close button -->
        <button
            id="seller-sidebar-close-btn"
            class="flex lg:hidden shrink-0 items-center justify-center w-8 h-8 rounded-lg text-text-tertiary hover:text-text-primary hover:bg-border-light transition-colors"
            aria-label={t.sellerSidebarCloseLabel}
        >
            <Icon name="x" size={18} />
        </button>
    </div>

    <!-- Main navigation -->
    <nav class="flex-1 overflow-y-auto overflow-x-hidden px-2 py-3" aria-label={t.sellerSidebarLabel}>
        <ul class="space-y-0.5" role="list">
            {sellerNavItems.map(item => (
                <li>
                    <a
                        href={item.href}
                        class:list={[
                            'sidebar-link relative flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium outline-none transition-colors focus-visible:ring-2 focus-visible:ring-accent',
                            isActive(item.href)
                                ? 'bg-accent text-bg'
                                : 'text-text-secondary hover:text-text-primary hover:bg-border-light',
                        ]}
                        aria-current={isActive(item.href) ? 'page' : undefined}
                    >
                        <Icon name={item.icon} size={20} class="shrink-0" />
                        <span class="sidebar-label truncate">{item.label}</span>
                        {item.href === '/sell/orders' && (pendingOrdersCount > 0 || deliveryFailedCount > 0) && (
                            <span class="sidebar-label ml-auto inline-flex items-center gap-1">
                                {pendingOrdersCount > 0 && (
                                    <span class:list={[
                                        'inline-flex items-center justify-center min-w-[18px] h-[18px] px-1 rounded-full text-[10px] font-bold leading-none',
                                        isActive(item.href) ? 'bg-bg text-accent' : 'bg-accent text-bg',
                                    ]}>
                                        {pendingOrdersCount}
                                    </span>
                                )}
                                {deliveryFailedCount > 0 && (
                                    <span class="inline-flex items-center justify-center min-w-[18px] h-[18px] px-1 rounded-full bg-red-500 text-white text-[10px] font-bold leading-none">
                                        {deliveryFailedCount}
                                    </span>
                                )}
                            </span>
                        )}
                        {item.href === '/sell/catalog' && incompleteProductsCount > 0 && (
                            <span class="sidebar-label ml-auto inline-flex items-center justify-center min-w-[18px] h-[18px] px-1 rounded-full bg-red-500 text-white text-[10px] font-bold leading-none">
                                {incompleteProductsCount}
                            </span>
                        )}
                        {item.href === '/sell/claims' && activeIncidents > 0 && (
                            <span class="sidebar-label ml-auto inline-flex items-center justify-center min-w-[18px] h-[18px] px-1 rounded-full bg-red-500 text-white text-[10px] font-bold leading-none">
                                {activeIncidents}
                            </span>
                        )}
                        <span class="sidebar-tooltip" role="tooltip" aria-hidden="true">{item.label}</span>
                    </a>
                </li>
            ))}
            <li>
                <button
                    type="button"
                    id="stripe-nav-btn"
                    data-stripe-status={stripeStatus}
                    class:list={[
                        'sidebar-link relative flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium outline-none transition-colors focus-visible:ring-2 focus-visible:ring-accent w-full text-left',
                        stripeStatus === 'ready'
                            ? 'text-text-secondary hover:text-text-primary hover:bg-border-light'
                            : 'text-amber-600 dark:text-amber-400 hover:bg-amber-50 dark:hover:bg-amber-900/10',
                    ]}
                >
                    <span class="relative shrink-0">
                        <Icon name="credit-card" size={20} />
                        {stripeStatus !== 'ready' && (
                            <span class="absolute -top-0.5 -right-0.5 flex h-2 w-2">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
                            </span>
                        )}
                    </span>
                    <span id="stripe-nav-label" class="sidebar-label truncate">{t.sellerNavStripe}</span>
                    <span id="stripe-nav-spinner" class="hidden shrink-0">
                        <svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                        </svg>
                    </span>
                    {stripeStatus !== 'ready' && (
                        <span id="stripe-nav-badge" class="sidebar-label ml-auto text-[10px] font-semibold uppercase tracking-wider text-amber-500 dark:text-amber-400">{t.sellerNavStripeWarning}</span>
                    )}
                    <span class="sidebar-tooltip" role="tooltip" aria-hidden="true">{t.sellerNavStripe}</span>
                </button>
            </li>
            <li>
                <a
                    href={sellerDetailsNavItem.href}
                    class:list={[
                        'sidebar-link relative flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium outline-none transition-colors focus-visible:ring-2 focus-visible:ring-accent',
                        isActive(sellerDetailsNavItem.href)
                            ? 'bg-accent text-bg'
                            : sellerDetailsIncomplete
                                ? 'text-amber-600 dark:text-amber-400 hover:bg-amber-50 dark:hover:bg-amber-900/10'
                                : 'text-text-secondary hover:text-text-primary hover:bg-border-light',
                    ]}
                    aria-current={isActive(sellerDetailsNavItem.href) ? 'page' : undefined}
                >
                    <span class="relative shrink-0">
                        <Icon name={sellerDetailsNavItem.icon} size={20} />
                        {sellerDetailsIncomplete && !isActive(sellerDetailsNavItem.href) && (
                            <span class="absolute -top-0.5 -right-0.5 flex h-2 w-2">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
                            </span>
                        )}
                    </span>
                    <span class="sidebar-label truncate">{sellerDetailsNavItem.label}</span>
                    {sellerDetailsIncomplete && (
                        <span class:list={[
                            'sidebar-label ml-auto text-[10px] font-semibold uppercase tracking-wider',
                            isActive(sellerDetailsNavItem.href) ? 'text-bg/80' : 'text-amber-500 dark:text-amber-400',
                        ]}>{t.sellerNavDetailsIncomplete}</span>
                    )}
                    <span class="sidebar-tooltip" role="tooltip" aria-hidden="true">{sellerDetailsNavItem.label}</span>
                </a>
            </li>
        </ul>
    </nav>

    <!-- Footer: view shop + settings -->
    <div class="px-2 py-3 border-t border-border shrink-0 flex flex-col gap-0.5">
        {shopSlug && (
            <a
                href={`/${shopSlug}`}
                target="_blank"
                rel="noopener noreferrer"
                class="sidebar-link relative flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium outline-none transition-colors focus-visible:ring-2 focus-visible:ring-accent text-text-secondary hover:text-text-primary hover:bg-border-light"
            >
                <Icon name="external-link" size={20} class="shrink-0" />
                <span class="sidebar-label truncate">{t.sellerSidebarViewShop}</span>
                <span class="sidebar-tooltip" role="tooltip" aria-hidden="true">{t.sellerSidebarViewShop}</span>
            </a>
        )}
        <a
            href={sellerFooterNavItem.href}
            class:list={[
                'sidebar-link relative flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium outline-none transition-colors focus-visible:ring-2 focus-visible:ring-accent',
                isActive(sellerFooterNavItem.href)
                    ? 'bg-accent text-bg'
                    : 'text-text-secondary hover:text-text-primary hover:bg-border-light',
            ]}
            aria-current={isActive(sellerFooterNavItem.href) ? 'page' : undefined}
        >
            <Icon name={sellerFooterNavItem.icon} size={20} class="shrink-0" />
            <span class="sidebar-label truncate">{sellerFooterNavItem.label}</span>
            <span class="sidebar-tooltip" role="tooltip" aria-hidden="true">{sellerFooterNavItem.label}</span>
        </a>
    </div>
</aside>

<style>
    /* ─── Mobile: fixed width & direct manipulation while swiping ─── */
    @media (max-width: 1023px) {
        #seller-sidebar {
            width: min(85vw, 240px);
            touch-action: pan-y;
        }

        #seller-sidebar.sidebar-dragging,
        #seller-sidebar-backdrop.sidebar-dragging {
            transition: none;
        }
    }

    /* ─── Desktop: width & collapse transition ─── */
    @media (min-width: 1024px) {
        #seller-sidebar {
            width: 240px;
            transition: width 220ms cubic-bezier(0.4, 0, 0.2, 1);
        }

        #seller-sidebar[data-collapsed] {
            width: 64px;
        }

        /* Hide text in collapsed state */
        #seller-sidebar[data-collapsed] .sidebar-brand,
        #seller-sidebar[data-collapsed] .sidebar-label {
            display: none;
        }

        /* Center header when collapsed */
        #seller-sidebar[data-collapsed] .sidebar-header {
            justify-content: center;
            padding-inline: 0;
        }

        /* Center nav links when collapsed */
        #seller-sidebar[data-collapsed] .sidebar-link {
            justify-content: center;
            gap: 0;
            padding-inline: 0;
            width: 40px;
            margin-inline: auto;
        }
    }

    /* ─── Tooltip: visible only when desktop + collapsed ─── */
    .sidebar-tooltip {
        display: none;
        position: absolute;
        left: calc(100% + 10px);
        top: 50%;
        transform: translateY(-50%);
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 500;
        white-space: nowrap;
        border-radius: 6px;
        pointer-events: none;
        z-index: 60;
        background-color: var(--color-text-primary-val);
        color: var(--color-bg-val);
        opacity: 0;
        transition: opacity 120ms ease;
    }

    @media (min-width: 1024px) {
        #seller-sidebar[data-collapsed] .sidebar-tooltip {
            display: block;
        }

        #seller-sidebar[data-collapsed] .sidebar-link:hover .sidebar-tooltip {
            opacity: 1;
        }
    }
</style>

<script>
    import { toast } from '../../lib/ui/toast';
    import { getClientT } from '../../lib/core/i18n';
const t = getClientT();

    declare global {
        interface Window {
            openSellerSidebar: () => void;
            closeSellerSidebar: () => void;
            sellerSidebarGestureAbortController?: AbortController;
        }
    }

    function initSellerSidebar() {
        const sidebar = document.getElementById('seller-sidebar') as HTMLElement | null;
        const backdrop = document.getElementById('seller-sidebar-backdrop') as HTMLElement | null;
        const collapseBtn = document.getElementById('seller-sidebar-collapse-btn');
        const closeBtn = document.getElementById('seller-sidebar-close-btn');

        if (!sidebar || sidebar.dataset.sidebarInitialized === 'true') return;
        sidebar.dataset.sidebarInitialized = 'true';

        // Document-level gesture listeners survive Astro navigations, so replace
        // the previous instance before wiring this sidebar.
        window.sellerSidebarGestureAbortController?.abort();
        const gestureAbortController = new AbortController();
        window.sellerSidebarGestureAbortController = gestureAbortController;
        const { signal } = gestureAbortController;

        // Restore desktop preference
        if (window.innerWidth >= 1024 && localStorage.getItem('fewya-seller-sidebar') === 'collapsed') {
            sidebar.dataset.collapsed = '';
            collapseBtn?.setAttribute('aria-label', 'Expandir menú');
        }

        // Desktop: toggle collapsed
        collapseBtn?.addEventListener('click', () => {
            const isCollapsed = 'collapsed' in sidebar.dataset;
            if (isCollapsed) {
                delete sidebar.dataset.collapsed;
                localStorage.setItem('fewya-seller-sidebar', 'expanded');
                collapseBtn.setAttribute('aria-label', 'Contraer menú');
            } else {
                sidebar.dataset.collapsed = '';
                localStorage.setItem('fewya-seller-sidebar', 'collapsed');
                collapseBtn.setAttribute('aria-label', 'Expandir menú');
            }
        });

        const mobileToggle = document.getElementById('seller-mobile-menu-toggle');

        const clearDragStyles = () => {
            sidebar.classList.remove('sidebar-dragging');
            sidebar.style.removeProperty('transform');
            if (backdrop) {
                backdrop.classList.remove('sidebar-dragging');
                backdrop.style.removeProperty('opacity');
            }
        };

        const setMobileSidebarOpen = (isOpen: boolean) => {
            clearDragStyles();
            sidebar.classList.toggle('-translate-x-full', !isOpen);
            mobileToggle?.setAttribute('aria-expanded', String(isOpen));

            if (backdrop) {
                backdrop.classList.toggle('pointer-events-none', !isOpen);
                backdrop.classList.toggle('opacity-0', !isOpen);
                backdrop.classList.toggle('opacity-100', isOpen);
            }
        };

        // Mobile: open
        window.openSellerSidebar = () => setMobileSidebarOpen(true);

        // Mobile: close
        window.closeSellerSidebar = () => setMobileSidebarOpen(false);

        closeBtn?.addEventListener('click', window.closeSellerSidebar);
        backdrop?.addEventListener('click', window.closeSellerSidebar);

        // Mobile: drag right from the left edge to open; drag the sidebar left
        // to close. Direction locking keeps normal vertical scrolling intact.
        const SWIPE_EDGE_WIDTH = 28;
        const SWIPE_DIRECTION_THRESHOLD = 8;
        const SWIPE_TRIGGER_RATIO = 0.3;
        const SWIPE_VELOCITY_THRESHOLD = 0.5;

        let gesture: {
            startX: number;
            startY: number;
            startTime: number;
            opening: boolean;
            horizontal: boolean;
        } | null = null;

        const restoreGestureStartState = () => {
            if (!gesture) return;
            setMobileSidebarOpen(!gesture.opening);
            gesture = null;
        };

        const onTouchStart = (event: TouchEvent) => {
            if (window.innerWidth >= 1024 || event.touches.length !== 1) return;

            const touch = event.touches[0];
            if (!touch) return;

            const isOpen = !sidebar.classList.contains('-translate-x-full');
            const target = event.target;
            const startedInsideSidebar = target instanceof Node && sidebar.contains(target);

            if ((!isOpen && touch.clientX > SWIPE_EDGE_WIDTH) || (isOpen && !startedInsideSidebar)) {
                return;
            }

            gesture = {
                startX: touch.clientX,
                startY: touch.clientY,
                startTime: performance.now(),
                opening: !isOpen,
                horizontal: false,
            };

            sidebar.classList.add('sidebar-dragging');
            backdrop?.classList.add('sidebar-dragging');
        };

        const onTouchMove = (event: TouchEvent) => {
            if (!gesture || event.touches.length !== 1) return;

            const touch = event.touches[0];
            if (!touch) return;

            const deltaX = touch.clientX - gesture.startX;
            const deltaY = touch.clientY - gesture.startY;
            const absX = Math.abs(deltaX);
            const absY = Math.abs(deltaY);

            if (!gesture.horizontal) {
                if (Math.max(absX, absY) < SWIPE_DIRECTION_THRESHOLD) return;
                if (absY >= absX) {
                    restoreGestureStartState();
                    return;
                }

                const movingInExpectedDirection = gesture.opening ? deltaX > 0 : deltaX < 0;
                if (!movingInExpectedDirection) {
                    restoreGestureStartState();
                    return;
                }

                gesture.horizontal = true;
            }

            event.preventDefault();

            const width = sidebar.getBoundingClientRect().width;
            if (width <= 0) return;

            const translateX = gesture.opening
                ? Math.min(0, -width + Math.max(0, deltaX))
                : Math.max(-width, Math.min(0, deltaX));
            const openProgress = 1 + translateX / width;

            sidebar.style.transform = `translateX(${translateX}px)`;
            if (backdrop) {
                backdrop.classList.remove('pointer-events-none', 'opacity-0', 'opacity-100');
                backdrop.style.opacity = String(openProgress);
            }
        };

        const onTouchEnd = (event: TouchEvent) => {
            if (!gesture) return;

            const touch = event.changedTouches[0];
            if (!touch) {
                restoreGestureStartState();
                return;
            }

            const elapsed = Math.max(performance.now() - gesture.startTime, 1);
            const deltaX = touch.clientX - gesture.startX;
            const distance = gesture.opening ? deltaX : -deltaX;
            const velocity = distance / elapsed;
            const width = sidebar.getBoundingClientRect().width;
            const shouldComplete = gesture.horizontal && (
                distance >= width * SWIPE_TRIGGER_RATIO ||
                velocity >= SWIPE_VELOCITY_THRESHOLD
            );
            const shouldOpen = shouldComplete ? gesture.opening : !gesture.opening;

            gesture = null;
            setMobileSidebarOpen(shouldOpen);
        };

        document.addEventListener('touchstart', onTouchStart, { passive: true, signal });
        document.addEventListener('touchmove', onTouchMove, { passive: false, signal });
        document.addEventListener('touchend', onTouchEnd, { passive: true, signal });
        document.addEventListener('touchcancel', restoreGestureStartState, { passive: true, signal });

        // On resize: reset mobile state when crossing the desktop breakpoint.
        let wasDesktop = window.innerWidth >= 1024;
        const onResize = () => {
            const isDesktop = window.innerWidth >= 1024;
            if (isDesktop) {
                gesture = null;
                clearDragStyles();
                sidebar.classList.remove('-translate-x-full');
                mobileToggle?.setAttribute('aria-expanded', 'false');
                if (backdrop) {
                    backdrop.classList.add('pointer-events-none', 'opacity-0');
                    backdrop.classList.remove('opacity-100');
                }
            } else if (wasDesktop) {
                window.closeSellerSidebar();
            }
            wasDesktop = isDesktop;
        };
        window.addEventListener('resize', onResize, { passive: true, signal });

        // Stripe nav button
        const stripeNavBtn = document.getElementById('stripe-nav-btn');
        const stripeNavLabel = document.getElementById('stripe-nav-label');
        const stripeNavSpinner = document.getElementById('stripe-nav-spinner');
        const stripeNavBadge = document.getElementById('stripe-nav-badge');
        if (stripeNavBtn) {
            const resetStripeBtn = () => {
                stripeNavBtn.removeAttribute('disabled');
                if (stripeNavLabel) stripeNavLabel.textContent = t.sellerNavStripe;
                if (stripeNavSpinner) stripeNavSpinner.classList.add('hidden');
                if (stripeNavBadge) stripeNavBadge.classList.remove('hidden');
            };

            stripeNavBtn.addEventListener('click', async () => {
                const status = stripeNavBtn.dataset.stripeStatus;

                // Account not connected yet → send to onboarding to finish setup.
                if (status !== 'ready') {
                    window.location.href = '/sell/onboarding';
                    return;
                }

                stripeNavBtn.setAttribute('disabled', 'true');
                if (stripeNavLabel) stripeNavLabel.textContent = t.sellerNavStripeOpening;
                if (stripeNavSpinner) stripeNavSpinner.classList.remove('hidden');
                if (stripeNavBadge) stripeNavBadge.classList.add('hidden');

                try {
                    const res = await fetch('/api/sell/stripe/connect', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ action: 'dashboard' })
                    });
                    const data = await res.json().catch(() => ({})) as { url?: string; error?: string };

                    if (res.ok && data.url) {
                        window.location.href = data.url;
                        return;
                    }

                    toast.error(data.error || t.sellerOnboardingStripeError);
                    resetStripeBtn();
                } catch {
                    toast.error(t.sellerOnboardingStripeError);
                    resetStripeBtn();
                }
            });
        }
    }

    document.addEventListener('astro:page-load', initSellerSidebar);
    if (document.readyState !== 'loading') initSellerSidebar();
    else document.addEventListener('DOMContentLoaded', initSellerSidebar);
</script>
