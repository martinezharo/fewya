---
import Icon from "../icons/Icon.astro";
import OrderCard from "./OrderCard.astro";
import type { OrderCardData, OrderItem } from "./OrderCard.astro";

import { api } from '../../../convex/_generated/api';
import { createRequestConvexClient } from "../../lib/core/auth";
const { t } = Astro.locals;

let orders: OrderCardData[] = [];

const convex = createRequestConvexClient(Astro.request);
if (convex) {
    try {
        const convexOrders = await convex.query(api.orders.listMine, {}) as unknown as Array<{
            orderId: string;
            publicId: string;
            status: string;
            totalAmount: number;
            subtotal: number;
            shipping: number;
            createdAt: string;
            cancellationReason: string | null;
            items: Array<OrderItem & { shopId: string; shopName: string }>;
            hasShipment: boolean;
            trackingNumber: string | null;
            trackingUrl: string | null;
            labelUrl: string | null;
            carrierName: string | null;
            incidentDescription: string | null;
            incidentPhotos: string[];
            sellerEmail: string | null;
            refundedAmount: number | null;
            shippingRetained: number | null;
            reviews: Record<string, { rating: number; comment: string | null }>;
        }>;
        orders = convexOrders.map((order) => ({
            ...order,
            createdAt: new Date(order.createdAt),
        }));
    } catch (error) {
        console.error('Convex buyer orders unavailable:', error);
    }
}
---

{orders.length > 0 ? (
    <div id="buyer-orders-list" class="flex flex-col gap-3">
        {orders.map((order) => (
            <OrderCard order={order} />
        ))}
    </div>
) : (
    <div class="flex flex-col items-center justify-center text-center px-6 py-20">
        <div class="w-16 h-16 mb-4 rounded-full bg-surface border border-border-light flex items-center justify-center text-text-tertiary">
            <Icon name="shopping-cart" size={26} />
        </div>
        <h2 class="text-[18px] font-semibold text-text-primary mb-2">
            {t.ordersEmpty}
        </h2>
        <p class="text-[14px] text-text-secondary mb-6 max-w-xs">
            {t.ordersEmptySub}
        </p>
        <a
            href="/"
            class="inline-flex items-center px-6 py-2.5 bg-accent text-bg text-sm font-semibold rounded-lg transition-colors hover:bg-accent-hover"
        >
            {t.ordersExploreCta}
        </a>
    </div>
)}

<script>
    async function autoConfirmDelivered() {
        const hasDelivered = document.querySelector('[data-order-status="delivered"]');
        if (!hasDelivered) return;
        try {
            const res = await fetch('/api/orders/auto-confirm', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({}),
            });
            const data = await res.json() as { autoConfirmed?: number };
            if ((data.autoConfirmed ?? 0) > 0) {
                window.location.reload();
            }
        } catch {
            // Silent fail
        }
    }

    function expandOrderFromHash() {
        const hash = window.location.hash;
        if (!hash || !hash.startsWith('#order-')) return;
        const orderId = decodeURIComponent(hash.slice('#order-'.length));
        if (!orderId) return;
        const article = document.querySelector('article[data-order-id="' + (window.CSS && CSS.escape ? CSS.escape(orderId) : orderId.replace(/"/g, '\\"')) + '"]');
        if (!article) return;
        const toggleBtn = article.querySelector('.order-toggle-btn');
        if (toggleBtn && toggleBtn.getAttribute('aria-expanded') !== 'true') {
            const details = article.querySelector('.order-details');
            const icon = toggleBtn.querySelector<HTMLElement>('.toggle-icon');
            if (details) details.classList.remove('hidden');
            if (icon) icon.style.transform = 'rotate(180deg)';
            toggleBtn.setAttribute('aria-expanded', 'true');
        }
        requestAnimationFrame(() => {
            article.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
    }

    function initBuyerOrders() {
        autoConfirmDelivered();
        expandOrderFromHash();
    }

    document.addEventListener('astro:page-load', initBuyerOrders);
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initBuyerOrders);
    } else {
        initBuyerOrders();
    }
</script>
