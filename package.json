{
  "name": "fewya-mvp",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "typegen": "wrangler types",
    "dev": "astro dev",
    "start": "bun run dev",
    "check": "bun run typegen && astro check",
    "build": "bun run typegen && astro check && astro build",
    "preview": "bun run typegen && astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:changed": "vitest run --changed",
    "test:e2e": "playwright test",
    "test:e2e:shipping": "playwright test tests/e2e/shipping-label-flow.spec.ts",
    "smoke:sendcloud-label": "bun scripts/smoke-sendcloud-label.ts",
    "migration:export": "bun scripts/migration/exportSupabase.ts",
    "migration:import": "bun scripts/migration/importConvex.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint-staged",
    "pre-push": "bun run check && bun run test"
  },
  "lint-staged": {
    "*.{ts,tsx,astro}": [
      "eslint --fix",
      "vitest related --run"
    ]
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/cloudflare": "^14.4.2",
    "@block65/webcrypto-web-push": "^1.0.2",
    "@clerk/astro": "^4.1.16",
    "@clerk/backend": "^3.26.1",
    "astro": "^7.4.2",
    "convex": "^1.47.0",
    "countries-list": "^3.4.1",
    "my-canvas-confetti": "npm:canvas-confetti@^1.9.4",
    "pdf-lib": "^1.17.1",
    "sortablejs": "^1.15.7",
    "stripe": "^22.6.2",
    "typescript": "^5.9.3",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.152.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^25.9.9",
    "@types/sortablejs": "^1.15.9",
    "@vite-pwa/astro": "^1.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "convex-test": "^0.0.57",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^1.7.0",
    "happy-dom": "^20.14.6",
    "lint-staged": "^17.6.0",
    "miniflare": "^4.20260730.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "typescript-eslint": "^8.72.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "fast-uri": "^3.1.9",
    "source-map-js": "^1.2.2"
  }
}
